rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // EXACT SINGLE SUPER ADMIN IDENTITY
    // Authorized strictly using the verified Firebase Authentication UID.
    // No hardcoded Gmail address or email comparison in security rules.
    // =========================================================================
    function isSuperAdmin() {
      return request.auth != null &&
        request.auth.uid == 'HOHTgjkAZlTPOO7bH98ukkw2vip1' &&
        request.auth.token.email_verified == true;
    }

    // =========================================================================
    // 1. PROFILE
    // Public can read published data; only Super Admin can write
    // =========================================================================
    match /profile/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 2. SKILLS
    // Public can read published data; only Super Admin can write
    // =========================================================================
    match /skills/{skillId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 3. PROJECTS
    // Public can read published projects; Super Admin has full CRUD
    // =========================================================================
    match /projects/{projectId} {
      allow read: if resource.data.published == true || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 4. EDUCATION
    // Public can read; only Super Admin can write
    // =========================================================================
    match /education/{educationId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 5. EXPERIENCE
    // Public can read; only Super Admin can write
    // =========================================================================
    match /experience/{experienceId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 6. CERTIFICATIONS
    // Public can read published certifications; Super Admin has full CRUD
    // =========================================================================
    match /certifications/{certId} {
      allow read: if resource.data.published == true || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 7. ACHIEVEMENTS
    // Public can read; only Super Admin can write
    // =========================================================================
    match /achievements/{achievementId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 8. SOCIAL LINKS
    // Public can read; only Super Admin can write
    // =========================================================================
    match /socialLinks/{socialLinkId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 9. SETTINGS
    // Only explicitly public settings readable; Super Admin has full CRUD
    // =========================================================================
    match /settings/{settingsId} {
      allow read: if resource.data.isPublic == true || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // Portfolio aggregate content document
    match /content/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 10. CONTACT MESSAGES (Strictly Private & Validated)
    // - Public visitors CANNOT read, update, or delete any messages.
    // - Public visitors can ONLY create messages matching strict schema limits.
    // - Rejects unexpected fields to prevent payload tampering.
    // - Super Admin can read, update (mark read), or delete.
    // =========================================================================
    match /messages/{messageId} {
      allow create: if isValidMessage();
      allow read, update, delete: if isSuperAdmin();
    }

    function isValidMessage() {
      let data = request.resource.data;
      return data.keys().hasAll(['name', 'email', 'subject', 'message']) &&
             data.keys().hasOnly(['name', 'email', 'subject', 'message', 'read', 'timestamp', 'createdAt', 'id', 'hp_check']) &&
             data.name is string &&
             data.name.size() >= 2 &&
             data.name.size() <= 100 &&
             data.email is string &&
             data.email.size() <= 100 &&
             data.email.matches('^[^@]+@[^@]+\\.[^@]+$') &&
             data.subject is string &&
             data.subject.size() >= 2 &&
             data.subject.size() <= 200 &&
             data.message is string &&
             data.message.size() >= 5 &&
             data.message.size() <= 2000 &&
             data.read == false;
    }

    // =========================================================================
    // DEFAULT DENY
    // Block any unspecified collections, subcollections, or paths
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
