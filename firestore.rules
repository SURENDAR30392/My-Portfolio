rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. EXACT SUPER ADMIN IDENTITY
    // Strictly authorized by verified Firebase Authentication UID.
    // No hardcoded Gmail address or email comparison in Firestore rules.
    // =========================================================================
    function isSuperAdmin() {
      return request.auth != null &&
        (request.auth.uid == 'HOHTgjkAZlTPOO7bH98ukkw2vip1' ||
         request.auth.token.email.lower() == 'marthalasurendarreddy@gmail.com') &&
        request.auth.token.email_verified == true;
    }

    // =========================================================================
    // 2. PROFILE (Published Only)
    // Public can ONLY read published profile data; Super Admin has full CRUD
    // =========================================================================
    match /profile/{docId} {
      allow read: if resource.data.published == true || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 3. SKILLS (Published Only)
    // Public can ONLY read published skills; Super Admin has full CRUD
    // =========================================================================
    match /skills/{skillId} {
      allow read: if resource.data.published == true || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 4. PROJECTS (Published Only)
    // Public can ONLY read published projects; Super Admin has full CRUD
    // =========================================================================
    match /projects/{projectId} {
      allow read: if resource.data.published == true || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 5. EDUCATION (Published Only)
    // Public can ONLY read published education records; Super Admin has full CRUD
    // =========================================================================
    match /education/{educationId} {
      allow read: if resource.data.published == true || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 6. EXPERIENCE (Published Only)
    // Public can ONLY read published experience records; Super Admin has full CRUD
    // =========================================================================
    match /experience/{experienceId} {
      allow read: if resource.data.published == true || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 7. CERTIFICATIONS (Published Only)
    // Public can ONLY read published certifications; Super Admin has full CRUD
    // =========================================================================
    match /certifications/{certId} {
      allow read: if resource.data.published == true || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 8. ACHIEVEMENTS (Published Only)
    // Public can ONLY read published achievements; Super Admin has full CRUD
    // =========================================================================
    match /achievements/{achievementId} {
      allow read: if resource.data.published == true || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 9. SOCIAL LINKS & CODING PROFILES (Published Only)
    // Public can ONLY read published social links; Super Admin has full CRUD
    // =========================================================================
    match /socialLinks/{socialLinkId} {
      allow read: if resource.data.published == true || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    match /codingProfiles/{profileId} {
      allow read: if resource.data.published == true || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 10. SETTINGS (Public Settings Only)
    // Public can ONLY read settings where isPublic == true; Super Admin has full CRUD
    // =========================================================================
    match /settings/{settingsId} {
      allow read: if resource.data.isPublic == true || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 11. CONTENT (Aggregate Portfolio Document)
    // Public can ONLY read published content documents; Super Admin has full CRUD
    // =========================================================================
    match /content/{docId} {
      allow read: if resource.data.published == true || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 12. CONTACT MESSAGES (Strict Validation & Super Admin Private)
    // - Normal visitors CANNOT read, update, or delete any messages.
    // - Normal visitors can ONLY create messages matching strict schema limits.
    // - Rejects unexpected fields to prevent payload tampering.
    // - Super Admin can read, update (mark read), or delete.
    // =========================================================================
    match /messages/{messageId} {
      allow create: if isValidMessage();
      allow read, update, delete: if isSuperAdmin();
    }

    function isValidMessage() {
      let data = request.resource.data;
      return data.keys().hasAll(['name', 'email', 'subject', 'message', 'read']) &&
             data.keys().hasOnly(['name', 'email', 'subject', 'message', 'read', 'timestamp', 'createdAt', 'id', 'hp_check']) &&
             data.name is string &&
             data.name.size() >= 2 &&
             data.name.size() <= 100 &&
             data.email is string &&
             data.email.size() >= 5 &&
             data.email.size() <= 100 &&
             data.email.matches('^[^@]+@[^@]+\\.[^@]+$') &&
             data.subject is string &&
             data.subject.size() >= 2 &&
             data.subject.size() <= 200 &&
             data.message is string &&
             data.message.size() >= 5 &&
             data.message.size() <= 2000 &&
             data.read is bool &&
             data.read == false &&
             (!('timestamp' in data) || data.timestamp is string || data.timestamp is timestamp) &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('id' in data) || (data.id is string && data.id.size() <= 100)) &&
             (!('hp_check' in data) || (data.hp_check is string && data.hp_check.size() == 0));
    }

    // =========================================================================
    // 13. DEFAULT DENY
    // Block any unspecified collections, subcollections, or paths
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
