rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // EXACTLY ONE SUPER ADMIN: Marthala Surendar Reddy with verified email
    function isSuperAdmin() {
      return isAuthenticated() && 
        request.auth.token.email.lower() == 'marthalasurendarreddy@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    // Portfolio Content Collection
    match /content/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Public Portfolio Collections (skills, projects, education, experience, certifications, achievements, settings)
    match /profile/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /projects/{projectId} {
      allow read: if resource.data.published == true || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    match /skills/{skillId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /education/{educationId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /experience/{experienceId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /certifications/{certId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /achievements/{achievementId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /socialLinks/{socialLinkId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /settings/{settingsId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Contact Messages Collection (Protected submission & Admin-only read)
    match /messages/{messageId} {
      // Normal visitors can create messages if valid
      allow create: if request.resource.data.name is string &&
                       request.resource.data.name.size() > 0 &&
                       request.resource.data.name.size() <= 100 &&
                       request.resource.data.email is string &&
                       request.resource.data.email.matches('^[^@]+@[^@]+\\.[^@]+$') &&
                       request.resource.data.message is string &&
                       request.resource.data.message.size() > 0 &&
                       request.resource.data.message.size() <= 3000;

      // STRICTLY SUPER ADMIN ONLY: Normal users CANNOT read, update or delete messages
      allow read, update, delete: if isSuperAdmin();
    }

  }
}
