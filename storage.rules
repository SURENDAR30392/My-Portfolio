rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSuperAdmin() {
      return request.auth != null && 
        (request.auth.uid == 'HOHTgjkAZlTPOO7bH98ukkw2vip1' || 
         request.auth.token.email.lower() == 'marthalasurendarreddy@gmail.com');
    }

    // Public portfolio images, certificates, and resume PDF
    match /{allPaths=**} {
      // Normal visitors can read/download published media
      allow read: if true;

      // Only the Super Admin can create, replace, or delete files (15MB limit)
      allow write, delete: if isSuperAdmin() &&
                              request.resource.size < 15 * 1024 * 1024;
    }
  }
}
